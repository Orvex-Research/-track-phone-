# Telegram Bot Token from @BotFather (Required)
bot=your_telegram_bot_token_here

# Render URL or Custom Domain (Optional - Render automatically detects RENDER_EXTERNAL_URL)
# If your Render service URL is https://my-bot.onrender.com, you can also set:
HOST_URL=https://my-bot.onrender.com

# Port (Render sets this automatically, default is 5000 for local testing)
PORT=5000
